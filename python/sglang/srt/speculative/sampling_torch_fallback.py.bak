"""Pure-PyTorch fallback implementations for sgl_kernel sampling ops.

These are used on ROCm/HIP where the sgl_kernel C++ sampling extensions
(top_k_renorm_probs, top_p_renorm_probs, tree_speculative_sampling_target_only)
are not compiled.
"""

import torch
from typing import Union


def top_k_renorm_prob(
    probs: torch.Tensor,
    top_k: Union[torch.Tensor, int],
) -> torch.Tensor:
    """Renormalize probabilities by top-k thresholding.

    Compatible with sgl_kernel.top_k_renorm_prob API.
    """
    if isinstance(top_k, int):
        top_ks = torch.full(
            (probs.shape[0],), top_k, dtype=torch.int32, device=probs.device
        )
    else:
        top_ks = top_k.to(torch.int32)

    probs_sort, probs_idx = probs.float().sort(dim=-1, descending=True)
    mask = torch.arange(probs.shape[-1], device=probs.device).unsqueeze(0) >= top_ks.unsqueeze(1)
    probs_sort.masked_fill_(mask, 0.0)
    renorm = probs_sort.sum(dim=-1, keepdim=True).clamp(min=1e-8)
    probs_sort.div_(renorm)
    result = torch.zeros_like(probs)
    result.scatter_(1, probs_idx, probs_sort)
    return result


def top_p_renorm_prob(
    probs: torch.Tensor,
    top_p: Union[torch.Tensor, float],
) -> torch.Tensor:
    """Renormalize probabilities by top-p (nucleus) thresholding.

    Compatible with sgl_kernel.top_p_renorm_prob API.
    """
    if isinstance(top_p, float):
        top_ps = torch.full(
            (probs.shape[0],), top_p, dtype=torch.float32, device=probs.device
        )
    else:
        top_ps = top_p.float()

    probs_sort, probs_idx = probs.float().sort(dim=-1, descending=True)
    cumsum = torch.cumsum(probs_sort, dim=-1)
    mask = (cumsum - probs_sort) > top_ps.unsqueeze(1)
    probs_sort.masked_fill_(mask, 0.0)
    renorm = probs_sort.sum(dim=-1, keepdim=True).clamp(min=1e-8)
    probs_sort.div_(renorm)
    result = torch.zeros_like(probs)
    result.scatter_(1, probs_idx, probs_sort)
    return result


def tree_speculative_sampling_target_only(
    predicts: torch.Tensor,
    accept_index: torch.Tensor,
    accept_token_num: torch.Tensor,
    candidates: torch.Tensor,
    retrive_index: torch.Tensor,
    retrive_next_token: torch.Tensor,
    retrive_next_sibling: torch.Tensor,
    uniform_samples: torch.Tensor,
    uniform_samples_for_final_sampling: torch.Tensor,
    target_probs: torch.Tensor,
    draft_probs: torch.Tensor,
    threshold_single: float = 1.0,
    threshold_acc: float = 1.0,
    deterministic: bool = True,
) -> None:
    """Tree speculative sampling (target-only variant).

    Pure-PyTorch implementation matching the sgl_kernel CUDA kernel.
    All tensor arguments are mutated in-place.
    """
    device = target_probs.device
    bs = candidates.shape[0]
    num_draft_tokens = candidates.shape[1]
    num_spec_step = accept_index.shape[1]
    vocab_size = target_probs.shape[2]
    capped_threshold_acc = max(threshold_acc, 1e-9)

    # Move to CPU for tree traversal (small tensors, sequential logic)
    candidates_cpu = candidates.cpu()
    retrive_index_cpu = retrive_index.cpu()
    retrive_next_token_cpu = retrive_next_token.cpu()
    retrive_next_sibling_cpu = retrive_next_sibling.cpu()
    uniform_samples_cpu = uniform_samples.cpu()
    uniform_samples_final_cpu = uniform_samples_for_final_sampling.cpu()
    target_probs_cpu = target_probs.cpu()

    predicts_cpu = predicts.cpu()
    accept_index_cpu = accept_index.cpu()
    accept_token_num_cpu = accept_token_num.cpu()
    draft_probs_cpu = draft_probs.cpu()

    for b in range(bs):
        prob_acc = 0.0
        cur_prob_row = 0  # index into target_probs[b, row, :]
        coin = uniform_samples_cpu[b, 0].item()
        last_accepted_retrive_idx = retrive_index_cpu[b, 0].item()
        accept_index_cpu[b, 0] = last_accepted_retrive_idx
        num_accepted = 0
        cur_index = 0

        for j in range(1, num_spec_step):
            cur_index = retrive_next_token_cpu[b, cur_index].item()
            while cur_index != -1:
                draft_token_id = candidates_cpu[b, cur_index].item()
                target_prob_single = target_probs_cpu[b, cur_prob_row, draft_token_id].item()
                prob_acc += target_prob_single

                if (coin <= prob_acc / capped_threshold_acc) or (
                    target_prob_single >= threshold_single
                ):
                    prob_acc = 0.0
                    cur_prob_row = cur_index
                    coin = uniform_samples_cpu[b, cur_index].item()
                    predicts_cpu[last_accepted_retrive_idx] = draft_token_id
                    num_accepted += 1
                    draft_index = retrive_index_cpu[b, cur_index].item()
                    accept_index_cpu[b, num_accepted] = draft_index
                    last_accepted_retrive_idx = draft_index
                    break
                else:
                    draft_probs_cpu[b, cur_prob_row, draft_token_id] = target_probs_cpu[
                        b, cur_prob_row, draft_token_id
                    ]
                    cur_index = retrive_next_sibling_cpu[b, cur_index].item()

            if cur_index == -1:
                break

        accept_token_num_cpu[b] = num_accepted

        # Final sampling from relu(target_probs - draft_probs)
        q = target_probs_cpu[b, cur_prob_row]
        p = draft_probs_cpu[b, cur_prob_row]
        relu_diff = torch.clamp(q - p, min=0.0)
        total = relu_diff.sum().item()
        if total > 0:
            coin_final = uniform_samples_final_cpu[b].item()
            cumsum = 0.0
            sampled_id = vocab_size - 1
            for v in range(vocab_size):
                cumsum += relu_diff[v].item()
                if cumsum > coin_final * total:
                    sampled_id = v
                    break
            predicts_cpu[last_accepted_retrive_idx] = sampled_id
        else:
            predicts_cpu[last_accepted_retrive_idx] = vocab_size - 1

    predicts.copy_(predicts_cpu.to(device))
    accept_index.copy_(accept_index_cpu.to(device))
    accept_token_num.copy_(accept_token_num_cpu.to(device))
    draft_probs.copy_(draft_probs_cpu.to(device))
