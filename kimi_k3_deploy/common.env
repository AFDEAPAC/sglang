# Shared configuration for the Kimi-K3 two-node SGLang deployment on AMD Instinct MI300X (gfx942).
# Sourced by start_kimi_k3_tp8_pp2.sh. Override any value by exporting it before calling the start script.
#
# Parallel layout: TP=8 within a node, PP=2 across nodes, EP left at 1. The a16w4 (bf16 x MXFP4) SiTUv2
# MoE kernel dispatches only without an expert mask, i.e. without expert parallelism, and its tiles are
# validated at the TP=8 shard of Kimi-K3 (inter_dim 3072/8=384). TP=8 x PP=2 keeps the 16-way weight
# split without an expert mask.

# --- Site settings: set these for your system ---
MODEL_PATH="${MODEL_PATH:-}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-kimi-k3}"
MASTER_ADDR="${MASTER_ADDR:-}"
DIST_INIT_ADDR="${DIST_INIT_ADDR:-${MASTER_ADDR}:20000}"
NNODES="${NNODES:-2}"
TP_SIZE="${TP_SIZE:-8}"
PP_SIZE="${PP_SIZE:-2}"
# EP_SIZE=1 means no expert parallelism; set it >1 only together with
# AITER_A16W4_ALLOW_EP=1, which lifts the kernel's expert_mask guard.
EP_SIZE="${EP_SIZE:-1}"
# Data parallel. With --enable-dp-attention, --tp-size is world size
# (tp % dp == 0). DSpark + DP>1 also needs ENABLE_DP_LM_HEAD=1.
DP_SIZE="${DP_SIZE:-1}"
ENABLE_DP_ATTENTION="${ENABLE_DP_ATTENTION:-0}"
ENABLE_DP_LM_HEAD="${ENABLE_DP_LM_HEAD:-0}"
# Empty = SGLang default (none).
MOE_A2A_BACKEND="${MOE_A2A_BACKEND:-}"
SERVE_HOST="${SERVE_HOST:-0.0.0.0}"
SERVE_PORT="${SERVE_PORT:-30000}"
# Inter-node data interface and the data IPs of the two nodes. Use the data interface, not a
# management port or a bridge, or RCCL and Gloo may pick the wrong one.
NETWORK_IFACE="${NETWORK_IFACE:-}"
NODE0_IP="${NODE0_IP:-}"
NODE1_IP="${NODE1_IP:-}"
# RCCL over RDMA: the RDMA devices of the node and the RoCE v2 GID index (3 on the system of the post).
# Check the RCCL log for NET/IB/GDRDMA on the connections between the two stages.
ENABLE_NCCL_IB="${ENABLE_NCCL_IB:-1}"
NCCL_IB_HCA="${NCCL_IB_HCA:-}"
NCCL_IB_GID_INDEX="${NCCL_IB_GID_INDEX:-0}"
NCCL_NET_GDR_LEVEL="${NCCL_NET_GDR_LEVEL:-PHB}"
RCCL_AINIC_ROCE="${RCCL_AINIC_ROCE:-0}"
MEM_FRACTION_STATIC="${MEM_FRACTION_STATIC:-0.85}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8_e4m3}"
# MLA through AITER: at TP8 each GPU holds 96/8=12 heads, zero-padded to the 16-head kernels.
ATTENTION_BACKEND="${ATTENTION_BACKEND:-aiter}"
# Kimi Delta Attention (linear attention) path.
LINEAR_ATTN_BACKEND="${LINEAR_ATTN_BACKEND:-triton}"
MOE_RUNNER_BACKEND="${MOE_RUNNER_BACKEND:-aiter}"
# Triton MLA decode knobs, used only when ATTENTION_BACKEND=triton.
SGLANG_MLA_DECODE_TUNE="${SGLANG_MLA_DECODE_TUNE:-1}"
TRITON_ATTENTION_NUM_KV_SPLITS="${TRITON_ATTENTION_NUM_KV_SPLITS:-8}"
TRITON_ATTENTION_SPLIT_TILE_SIZE="${TRITON_ATTENTION_SPLIT_TILE_SIZE:-}"
CHUNKED_PREFILL_SIZE="${CHUNKED_PREFILL_SIZE:-8192}"
LOG_DIR="${LOG_DIR:-./logs}"
# --- All-reduce / CUDA graphs ---
# RCCL channels for the cross-node communicators. Do not set UNSET_NCCL_NCHANNELS=1 for serving.
NCCL_MAX_NCHANNELS="${NCCL_MAX_NCHANNELS:-64}"
NCCL_MIN_NCHANNELS="${NCCL_MIN_NCHANNELS:-8}"
UNSET_NCCL_NCHANNELS="${UNSET_NCCL_NCHANNELS:-0}"
NCCL_BUFFSIZE="${NCCL_BUFFSIZE:-1048576}"
# Overlap knobs (default off / driver default).
CUDA_DEVICE_MAX_CONNECTIONS="${CUDA_DEVICE_MAX_CONNECTIONS:-}"
TORCH_NCCL_HIGH_PRIORITY="${TORCH_NCCL_HIGH_PRIORITY:-0}"
# Shader blit copies instead of SDMA engines (ROCm).
GPU_FORCE_BLIT_COPY_SIZE="${GPU_FORCE_BLIT_COPY_SIZE:-4090000}"
HSA_ENABLE_SDMA="${HSA_ENABLE_SDMA:-0}"
# In-node all-reduce with the AITER custom kernel, fused with the residual add and RMSNorm.
# Requires expandable_segments:False so hipIpcGetMemHandle succeeds.
ENABLE_CUSTOM_AR="${ENABLE_CUSTOM_AR:-1}"
SGLANG_USE_AITER_AR="${SGLANG_USE_AITER_AR:-1}"
ENABLE_AITER_AR_FUSION="${ENABLE_AITER_AR_FUSION:-1}"
# CUDA graphs are off by default here; the configuration of the post sets
# CUDA_GRAPH_BACKEND_DECODE=full and CUDA_GRAPH_MAX_BS_DECODE=32.
CUDA_GRAPH_BACKEND_DECODE="${CUDA_GRAPH_BACKEND_DECODE:-disabled}"
CUDA_GRAPH_BACKEND_PREFILL="${CUDA_GRAPH_BACKEND_PREFILL:-disabled}"
CUDA_GRAPH_MAX_BS_DECODE="${CUDA_GRAPH_MAX_BS_DECODE:-8}"
# Tuned tables: point these at aiter/configs/kimi_k3_gfx942/ of the AITER branch.
# a16wmix MoE tiles for bf16 activations (tune_a16wmix_moe.py).
FLYDSL_A16WMIX_TUNED_CSV="${FLYDSL_A16WMIX_TUNED_CSV:-}"
# Dense bf16 GEMM table (AITER).
AITER_CONFIG_GEMM_BF16="${AITER_CONFIG_GEMM_BF16:-}"
# expandable_segments:True breaks hipIpcGetMemHandle. The fused all-reduce needs False.
PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:False}"
# --- DSpark speculative decoding (off by default) ---
# DSpark requires pp_size == 1. Layout 1node = TP8 PP1 nnodes=1 (does not fit 8 x 192 GiB);
# 2node = TP16 PP1 nnodes=2 (the same 16 GPUs without PP).
ENABLE_DSPARK="${ENABLE_DSPARK:-0}"
DSPARK_LAYOUT="${DSPARK_LAYOUT:-2node}"
SPECULATIVE_DRAFT_MODEL_PATH="${SPECULATIVE_DRAFT_MODEL_PATH:-}"
SPECULATIVE_DSPARK_BLOCK_SIZE="${SPECULATIVE_DSPARK_BLOCK_SIZE:-7}"
ENABLE_LINEAR_REPLAYSSM_SPEC="${ENABLE_LINEAR_REPLAYSSM_SPEC:-1}"
SPECULATIVE_DRAFT_ATTENTION_BACKEND="${SPECULATIVE_DRAFT_ATTENTION_BACKEND:-}"
MAX_RUNNING_REQUESTS="${MAX_RUNNING_REQUESTS:-32}"
MAX_MAMBA_CACHE_SIZE="${MAX_MAMBA_CACHE_SIZE:-160}"
AITER_A16WMIX_DEBUG="${AITER_A16WMIX_DEBUG:-0}"
# --- Prefill-decode disaggregation (off by default) ---
# Two independent nnodes=1 engines: node0 prefill, node1 decode, plus a router.
PD_DISAGG="${PD_DISAGG:-0}"
PD_TRANSFER_BACKEND="${PD_TRANSFER_BACKEND:-mooncake_tcp}"
PD_BOOTSTRAP_PORT="${PD_BOOTSTRAP_PORT:-8998}"
PD_PREFILL_PORT="${PD_PREFILL_PORT:-30000}"
PD_DECODE_PORT="${PD_DECODE_PORT:-30001}"
PD_ROUTER_PORT="${PD_ROUTER_PORT:-8000}"
NCCL_CUMEM_ENABLE="${NCCL_CUMEM_ENABLE:-0}"
NCCL_DMABUF_ENABLE="${NCCL_DMABUF_ENABLE:-0}"
RCCL_FORCE_ENABLE_DMABUF="${RCCL_FORCE_ENABLE_DMABUF:-0}"
NCCL_IB_PCI_RELAXED_ORDERING="${NCCL_IB_PCI_RELAXED_ORDERING:-1}"
# --- Kimi-K3 switches ---
# Each switch below is on by default; set it to 0 (or to an empty list) to turn that change off.
# They are exported here because start_kimi_k3_tp8_pp2.sh does not re-export them.
# KDA input projections as one GEMM; radix-select top-16 routing; MLA decode writes the value
# up-projection into a buffer allocated once.
export SGLANG_ROCM_K3_FUSE_KDA_INPROJ="${SGLANG_ROCM_K3_FUSE_KDA_INPROJ:-1}"
export SGLANG_K3_RADIX4_TOPK="${SGLANG_K3_RADIX4_TOPK:-1}"
export SGLANG_DECODE_MLA_ABSORB_V_BUF="${SGLANG_DECODE_MLA_ABSORB_V_BUF:-1}"
# AITER per-token fp8 GEMM for the online-fp8 dense layers (only with a config.json that has a
# linear_fp8_config block), and the 47/46 layer split between the two pipeline stages.
export SGLANG_USE_AITER_FP8_PER_TOKEN="${SGLANG_USE_AITER_FP8_PER_TOKEN:-1}"
export SGLANG_PP_LAYER_PARTITION="${SGLANG_PP_LAYER_PARTITION:-47,46}"
# Dense fp8 GEMM table (AITER, a8w8 bpreshuffle); read through os.getenv, so it must be exported.
export AITER_CONFIG_GEMM_A8W8_BPRESHUFFLE="${AITER_CONFIG_GEMM_A8W8_BPRESHUFFLE:-}"
# Fused KDA decode (conv1d + delta-rule recurrence + gated RMSNorm in one Triton kernel).
export SGLANG_AITER_FUSED_KDA_DECODE="${SGLANG_AITER_FUSED_KDA_DECODE:-1}"
# Router bias cache, MoE gemm1 grid cap, no second MoE buffer zeroing.
export SGLANG_TOPK_BIAS_CACHE="${SGLANG_TOPK_BIAS_CACHE:-1}"
export AITER_A16WMIX_GEMM1_GRID_CAP="${AITER_A16WMIX_GEMM1_GRID_CAP:-1}"
export AITER_A16WMIX_SKIP_MOE_BUF_ZERO="${AITER_A16WMIX_SKIP_MOE_BUF_ZERO:-1}"
export SGLANG_DECODE_MOE_ROUTED_COPY="${SGLANG_DECODE_MOE_ROUTED_COPY:-0}"
export SGLANG_K3_AGG_NUM_WARPS="${SGLANG_K3_AGG_NUM_WARPS:-8}"
# Fused kernels that produce the same bits as the kernels they replace.
export SGLANG_K3_MLA_FUSED_PREP="${SGLANG_K3_MLA_FUSED_PREP:-1}"
export SGLANG_K3_FRONT_EPILOGUE="${SGLANG_K3_FRONT_EPILOGUE:-1}"
export AITER_K3_FUSED_ROUTE_PREP="${AITER_K3_FUSED_ROUTE_PREP:-1}"
export SGLANG_K3_AITER_ATTN_RES="${SGLANG_K3_AITER_ATTN_RES:-1}"
# MoE output written straight into the [latent | shared] buffer.
export SGLANG_K3_MOE_OUT_DIRECT="${SGLANG_K3_MOE_OUT_DIRECT:-1}"
# Token-parallel prefill for the replicated router and latent projections (>= 1024 tokens,
# tokens % tp == 0): each rank works on its 1/tp slice of the tokens.
export SGLANG_K3_TP_PREFILL_LATENT="${SGLANG_K3_TP_PREFILL_LATENT:-1}"
# Prefill-only dynamic fp8 (per-token x per-channel) for the named bf16 dense GEMMs at >= 1024 tokens.
export SGLANG_K3_PREFILL_FP8="${SGLANG_K3_PREFILL_FP8-kda,front,up,mla_gate}"
# Dynamic fp8 on the decode path for the named GEMMs; fp8 copies are built before graph capture.
export SGLANG_K3_DECODE_FP8="${SGLANG_K3_DECODE_FP8-front,up,kda}"
# MoE gemm2 LDS block sized max(A tile, epilogue accumulator) instead of their sum at BM >= 32.
export A16WMIX_GEMM2_LDS_OVERLAY="${A16WMIX_GEMM2_LDS_OVERLAY:-1}"
# Prefill stage-2 MoE input quantized by k3_rowquant (bit-identical to the per-token kernel).
export AITER_K3_S2_ROWQUANT="${AITER_K3_S2_ROWQUANT:-1}"
# Prefill: o_proj reduce-scattered and the attention-residual aggregation on this rank's token rows.
export SGLANG_K3_SP_PREFILL_AGG2="${SGLANG_K3_SP_PREFILL_AGG2:-1}"
# MLA decode with fp8 queries on a single-query-row kernel.
export SGLANG_K3_MLA_DECODE_A8W8="${SGLANG_K3_MLA_DECODE_A8W8:-1}"
# MLA decode work split across all CUs, and the first stage posting its pipeline receive after its
# forward pass. Both are read at server start.
export SGLANG_K3_MLA_DECODE_BALANCED="${SGLANG_K3_MLA_DECODE_BALANCED:-1}"
export SGLANG_ENABLE_PP_OUTPUT_RECV_AFTER_FORWARD="${SGLANG_ENABLE_PP_OUTPUT_RECV_AFTER_FORWARD:-1}"
# OpenAI request conversion on the event loop instead of the executor (the tokenizer holds the GIL).
export SGLANG_OPENAI_CONVERT_IN_EXECUTOR="${SGLANG_OPENAI_CONVERT_IN_EXECUTOR:-0}"
# No HiCache host mirror for the DSpark draft under DCP.
export SGLANG_HICACHE_DCP_DRAFT_HOST="${SGLANG_HICACHE_DCP_DRAFT_HOST:-0}"
# Mamba radix cache keeps the prompt-end state checkpoint rather than the branching point.
export SGLANG_MAMBA_PREFER_PROMPT_END_CHECKPOINT="${SGLANG_MAMBA_PREFER_PROMPT_END_CHECKPOINT:-1}"
# Decode glue fusions that write the same bytes as the ops they replace.
export SGLANG_K3_DCP_HG_TRITON="${SGLANG_K3_DCP_HG_TRITON:-1}"
export SGLANG_K3_MLA_KV_FUSED_CAST="${SGLANG_K3_MLA_KV_FUSED_CAST:-1}"
export SGLANG_K3_AGG_FP8_OUT="${SGLANG_K3_AGG_FP8_OUT:-1}"
# MLA prefill attention in fp8.
export SGLANG_K3_MLA_PREFILL_FP8="${SGLANG_K3_MLA_PREFILL_FP8:-1}"
export SGLANG_K3_MLA_PREFILL_FP8_FUSED="${SGLANG_K3_MLA_PREFILL_FP8_FUSED:-1}"
