# Shared configuration for the Kimi-K3 2-node SGLang deployment (AMD MI308X / gfx942).
# Sourced by start_node0.sh / start_node1.sh. Override any value by exporting it
# before calling the start script.
#
# Parallel layout: TP=8 within a node, PP=2 across nodes, EP left at 1.
# Why not TP=16/EP=16: the a16w4 (bf16 x MXFP4) SiTUv2 kernel from AFDEAPAC/aiter
# 3e7aa9214 dispatches only when expert_mask is None, i.e. no expert parallelism,
# and its tile selection is validated at Kimi-K3's TP=8 shard (inter_dim 3072/8=384).
# TP=8 x PP=2 keeps the same 16-way weight split without an expert mask.

MODEL_PATH="${MODEL_PATH:-/mnt/md0/mh/models/Kimi-K3-fp8v3}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-kimi-k3}"
MASTER_ADDR="${MASTER_ADDR:-10.170.168.1}"
DIST_INIT_ADDR="${DIST_INIT_ADDR:-${MASTER_ADDR}:20000}"
NNODES="${NNODES:-2}"
TP_SIZE="${TP_SIZE:-8}"
PP_SIZE="${PP_SIZE:-2}"
# EP_SIZE=1 means "no expert parallelism"; set it >1 only together with
# AITER_A16W4_ALLOW_EP=1, which lifts the kernel's expert_mask guard.
EP_SIZE="${EP_SIZE:-1}"
# Data parallel. With --enable-dp-attention, --tp-size is world size
# (tp % dp == 0). DSpark + DP>1 also needs ENABLE_DP_LM_HEAD=1.
DP_SIZE="${DP_SIZE:-1}"
ENABLE_DP_ATTENTION="${ENABLE_DP_ATTENTION:-0}"
ENABLE_DP_LM_HEAD="${ENABLE_DP_LM_HEAD:-0}"
# Empty = SGLang default (none). deepep/mooncake are CUDA-oriented.
MOE_A2A_BACKEND="${MOE_A2A_BACKEND:-}"
SERVE_HOST="${SERVE_HOST:-0.0.0.0}"
SERVE_PORT="${SERVE_PORT:-30000}"
# Inter-node fabric. Node 1 also carries a 169.254 link and a kube-bridge that
# RCCL/Gloo will otherwise select and hang on.
NETWORK_IFACE="${NETWORK_IFACE:-ens5f0np0}"
NODE0_IP="${NODE0_IP:-10.170.168.1}"
NODE1_IP="${NODE1_IP:-10.170.168.2}"
# IB / RCCL — adapted from lab example (fic2_soe_bond* / enp0s20f0u10u3 / GID=1)
# to this MI308X pair:
#   - HCAs are mlx5_* (InfiniBand link layer), not fic2_soe_bond*
#   - Common ACTIVE IB ports on BOTH nodes: mlx5_0,1,4,5
#   - Socket NIC with 10.170.168.x: ens5f0np0
#   - GID[0] is the only non-zero link-local GID (example GID=1 was RoCE)
# Do NOT force GPU Direct RDMA: hosts lack amdp2p/peermem, and DMAbuf fallback
# fails with `ibv_reg_mr_iova2 ... Invalid argument`. With GDR_LEVEL=0, IB uses
# host bounce buffers and ncclCommInitRank succeeds (verified 2-node smoke).
# Example also had RCCL_AINIC_ROCE=1 (RoCE); this fabric is native IB so default is 0.
ENABLE_NCCL_IB="${ENABLE_NCCL_IB:-1}"
NCCL_IB_HCA="${NCCL_IB_HCA:-mlx5_0,mlx5_1,mlx5_4,mlx5_5}"
NCCL_IB_GID_INDEX="${NCCL_IB_GID_INDEX:-0}"
NCCL_NET_GDR_LEVEL="${NCCL_NET_GDR_LEVEL:-PHB}"
RCCL_AINIC_ROCE="${RCCL_AINIC_ROCE:-0}"
MEM_FRACTION_STATIC="${MEM_FRACTION_STATIC:-0.85}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8_e4m3}"
# Aiter MLA attention enabled via local SGLang patch: TP8 => 96/8=12 heads,
# zero-padded to QH16 ASM kernels (see tools/patch_aiter_mla12.py). Without the
# patch, AiterAttnBackend only accepts 4, 8, or multiples of 16 in [16,128].
ATTENTION_BACKEND="${ATTENTION_BACKEND:-aiter}"
# Kimi Delta / linear attention path (aiter is NOT in the allowed set).
LINEAR_ATTN_BACKEND="${LINEAR_ATTN_BACKEND:-triton}"
MOE_RUNNER_BACKEND="${MOE_RUNNER_BACKEND:-aiter}"
# Triton MLA decode autotune kept as fallback knobs when attention=triton.
SGLANG_MLA_DECODE_TUNE="${SGLANG_MLA_DECODE_TUNE:-1}"
TRITON_ATTENTION_NUM_KV_SPLITS="${TRITON_ATTENTION_NUM_KV_SPLITS:-8}"
TRITON_ATTENTION_SPLIT_TILE_SIZE="${TRITON_ATTENTION_SPLIT_TILE_SIZE:-}"
CHUNKED_PREFILL_SIZE="${CHUNKED_PREFILL_SIZE:-8192}"
LOG_DIR="${LOG_DIR:-/opt/scripts/logs}"
# --- All-reduce / CUDA graphs ---
# NCCL channels: keep MIN=8 MAX=64 (best of graphs-off A/B 2026-08-20:
# 8–16=37.99, 8–32=38.01, 8–64=38.15, unset=38.12 out tok/s). See
# logs/trial_nccl_channels.md. Do not set UNSET_NCCL_NCHANNELS=1 for serving.
NCCL_MAX_NCHANNELS="${NCCL_MAX_NCHANNELS:-64}"
NCCL_MIN_NCHANNELS="${NCCL_MIN_NCHANNELS:-8}"
UNSET_NCCL_NCHANNELS="${UNSET_NCCL_NCHANNELS:-0}"
NCCL_BUFFSIZE="${NCCL_BUFFSIZE:-1048576}"
# Overlap trial knobs (default off / driver default). See tools/trial_ranked_next.py.
CUDA_DEVICE_MAX_CONNECTIONS="${CUDA_DEVICE_MAX_CONNECTIONS:-}"
TORCH_NCCL_HIGH_PRIORITY="${TORCH_NCCL_HIGH_PRIORITY:-0}"
# Force shader blit copies instead of SDMA (ROCm). Applied on top of the serving default.
GPU_FORCE_BLIT_COPY_SIZE="${GPU_FORCE_BLIT_COPY_SIZE:-4090000}"
HSA_ENABLE_SDMA="${HSA_ENABLE_SDMA:-0}"
# Fused aiter AR is the serving default (2026-08-20: 39.67 vs 38.15 out tok/s).
# Requires expandable_segments:False so hipIpcGetMemHandle succeeds. GDR stays 0.
ENABLE_CUSTOM_AR="${ENABLE_CUSTOM_AR:-1}"
SGLANG_USE_AITER_AR="${SGLANG_USE_AITER_AR:-1}"
ENABLE_AITER_AR_FUSION="${ENABLE_AITER_AR_FUSION:-1}"
# Decode graphs capture cleanly (full, max_bs=8) but TPOT got worse on this stack.
# Leave disabled. Channel count is already A/B'd; do not combine graphs with 8–16.
CUDA_GRAPH_BACKEND_DECODE="${CUDA_GRAPH_BACKEND_DECODE:-disabled}"
CUDA_GRAPH_BACKEND_PREFILL="${CUDA_GRAPH_BACKEND_PREFILL:-disabled}"
CUDA_GRAPH_MAX_BS_DECODE="${CUDA_GRAPH_MAX_BS_DECODE:-8}"
# gfx942 a16wmix tile CSV from tools/tune_a16wmix_moe.py (decode tile_m=16).
FLYDSL_A16WMIX_TUNED_CSV="${FLYDSL_A16WMIX_TUNED_CSV:-/opt/scripts/configs/a16wmix_tuned.csv}"
# gfx942/cu80 hipBLASLt table (opus winners stripped — those kernel ids are not in serving lookup)
AITER_CONFIG_GEMM_BF16="${AITER_CONFIG_GEMM_BF16:-/opt/scripts/configs/kimik3_bf16_tuned_gemm_gfx942.csv}"
# expandable_segments:True breaks hipIpcGetMemHandle (rc=1). Fused AR needs False.
PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:False}"
# --- DSpark speculative decoding ---
# HF card (RadixArk/Kimi-K3-DSpark) + SGLang: DSPARK requires pp_size == 1.
# The NVIDIA sample also uses --dcp-size 8 and --speculative-draft-attention-backend
# trtllm_mha; those are CUDA/TRT. Leave them unset on gfx942.
# Layout: 1node = TP8 PP1 nnodes=1 (HF card; OOM on 192 GiB — full depth on 8 GPUs).
#         2node = TP16 PP1 nnodes=2 (same 16 GPUs, PP dropped; required for DSPARK).
ENABLE_DSPARK="${ENABLE_DSPARK:-0}"
DSPARK_LAYOUT="${DSPARK_LAYOUT:-2node}"
SPECULATIVE_DRAFT_MODEL_PATH="${SPECULATIVE_DRAFT_MODEL_PATH:-/mnt/md0/models/Kimi-K3-DSpark}"
SPECULATIVE_DSPARK_BLOCK_SIZE="${SPECULATIVE_DSPARK_BLOCK_SIZE:-7}"
ENABLE_LINEAR_REPLAYSSM_SPEC="${ENABLE_LINEAR_REPLAYSSM_SPEC:-1}"
SPECULATIVE_DRAFT_ATTENTION_BACKEND="${SPECULATIVE_DRAFT_ATTENTION_BACKEND:-}"
MAX_RUNNING_REQUESTS="${MAX_RUNNING_REQUESTS:-32}"
MAX_MAMBA_CACHE_SIZE="${MAX_MAMBA_CACHE_SIZE:-160}"
AITER_A16WMIX_DEBUG="${AITER_A16WMIX_DEBUG:-0}"
# --- Prefill-decode disaggregation (off by default) ---
# Two independent nnodes=1 engines: node0 prefill, node1 decode, plus pd_router.py.
# Blockers on this pair: (1) TP8×PP1 on 8×192 GiB OOMs (~188 GiB creating weights);
# (2) PyPI mooncake-transfer-engine links libcudart.so.12 / libcuda.so.1.
PD_DISAGG="${PD_DISAGG:-0}"
PD_TRANSFER_BACKEND="${PD_TRANSFER_BACKEND:-mooncake_tcp}"
PD_BOOTSTRAP_PORT="${PD_BOOTSTRAP_PORT:-8998}"
PD_PREFILL_PORT="${PD_PREFILL_PORT:-30000}"
PD_DECODE_PORT="${PD_DECODE_PORT:-30001}"
PD_ROUTER_PORT="${PD_ROUTER_PORT:-8000}"
NCCL_CUMEM_ENABLE="${NCCL_CUMEM_ENABLE:-0}"
NCCL_DMABUF_ENABLE="${NCCL_DMABUF_ENABLE:-0}"
RCCL_FORCE_ENABLE_DMABUF="${RCCL_FORCE_ENABLE_DMABUF:-0}"
NCCL_IB_PCI_RELAXED_ORDERING="${NCCL_IB_PCI_RELAXED_ORDERING:-1}"
# --- K3_ADOPTED_DECODE_FLAGS: adopted decode optimizations (2026-09-10) ---
# `export` is required here: common.env otherwise uses plain assignment and relies on
# start_kimi_k3_tp8_pp2.sh re-exporting each var, which it does NOT do for these three.
# The ${X:-1} form keeps an explicit caller override winning (set 0 to revert).
# SGLANG_DECODE_MLA_ABSORB_V_BUF: MLA absorb v-BMM writes into a persistent
# (batch, heads, dim) buffer so the downstream transpose+flatten is a free view.
# Measured: -110 copy kernels/rank/10 decode steps on PP0 and -130 on PP1,
# decode TPOT 57.733 -> 57.547 ms, GSM8K 0.985.
# Evidence: evo-kimi-k3-moe/knowledge/known_bad.md, DECODE COPY ELIMINATION CAMPAIGN.
export SGLANG_ROCM_K3_FUSE_KDA_INPROJ="${SGLANG_ROCM_K3_FUSE_KDA_INPROJ:-1}"
export SGLANG_K3_RADIX4_TOPK="${SGLANG_K3_RADIX4_TOPK:-1}"
export SGLANG_DECODE_MLA_ABSORB_V_BUF="${SGLANG_DECODE_MLA_ABSORB_V_BUF:-1}"
# --- K3_COMBO_4746_FP8V3: adopted combo (2026-09-14) ---
# Measured +1.76% decode TPOT and GSM8K +0.13 pp vs the 46,47 + bf16 baseline
# (tools/combo_4746_fp8v3.sh, S4 1319x3, same-session baseline 2026-09-11).
# Landed together because they were measured together; splitting them re-opens
# the composition question.
# SGLANG_PP_LAYER_PARTITION=47,46 moves one decoder layer from PP stage 1 to
# stage 0, evening out the two-node pipeline. Read by
# sglang/srt/distributed/utils.py:103 (os.getenv), so it must be exported.
# SGLANG_USE_AITER_FP8_PER_TOKEN=1 selects the aiter per-token dense fp8 GEMM.
# Read by sglang/srt/layers/quantization/fp8.py:481. Only meaningful together
# with the fp8v3 checkpoint set as MODEL_PATH above; on the bf16 checkpoint it
# is inert.
export SGLANG_USE_AITER_FP8_PER_TOKEN="${SGLANG_USE_AITER_FP8_PER_TOKEN:-1}"
export SGLANG_PP_LAYER_PARTITION="${SGLANG_PP_LAYER_PARTITION:-47,46}"
# --- K3_A8W8_TUNED_GEMM: tuned gfx942 dense fp8 GEMM config (2026-09-14) ---
# +0.40% decode TPOT (56.455 -> 56.230 ms), GSM8K 0.985 unchanged
# (tools/stageT_ab.sh, same-session A/B). Adopted by decision despite sitting just
# under the 0.5% bar: config-only, no code change, accuracy-neutral.
# 96 rows tuned with the FlyDSL MFMA preshuffle pipeline and merged over the shipped
# 598; CK was never involved (libtype is per-row and the dispatcher honours it,
# aiter/ops/gemm_op_a8w8.py:748-757). Without this the shipped CSV has a single
# gfx942+e4m3fnuz row and every dense fp8 GEMM runs on aiter's DEFAULT config.
# `export` is required: read via os.getenv at aiter/jit/core.py:101-104, and
# start_kimi_k3_tp8_pp2.sh re-exports only AITER_CONFIG_GEMM_BF16 (:122-124).
export AITER_CONFIG_GEMM_A8W8_BPRESHUFFLE="${AITER_CONFIG_GEMM_A8W8_BPRESHUFFLE:-/opt/scripts/configs/a8w8_bpreshuffle_tuned_gfx942.csv}"
# --- K3_ADOPTED_KDA_FUSED_DECODE: adopted 2026-09-16 ---
# aiter #4712 fused KDA decode (conv1d + delta-rule recurrence + gated RMSNorm in one
# Triton kernel), merged upstream in aiter v0.1.22.
# Measured +2.59% decode TPOT (56.270 -> 54.810 ms) with GSM8K unchanged at 0.985,
# same-session A/B via tools/ab_kda_fused_20260916.sh. Profile confirms the fast path:
# fused_conv_recurrent_norm_kernel 16,560 calls, kda_packed_decode_kernel 0,
# layer_norm_gated_fwd_kernel 0.
# Requires the K3_AITER_FUSED_KDA_PORT adapter (tools/apply_fused_kda_aiter_port.py).
# Read from the process environment by sglang/srt/environ.py, so it must be exported.
export SGLANG_AITER_FUSED_KDA_DECODE="${SGLANG_AITER_FUSED_KDA_DECODE:-1}"
# Wave A adopted 2026-09-30 (A2 bias cache + A4 gemm1 grid cap)
export SGLANG_TOPK_BIAS_CACHE="${SGLANG_TOPK_BIAS_CACHE:-1}"
export AITER_A16WMIX_GEMM1_GRID_CAP="${AITER_A16WMIX_GEMM1_GRID_CAP:-1}"
export AITER_A16WMIX_SKIP_MOE_BUF_ZERO="${AITER_A16WMIX_SKIP_MOE_BUF_ZERO:-1}"
export SGLANG_DECODE_MOE_ROUTED_COPY="${SGLANG_DECODE_MOE_ROUTED_COPY:-0}"
export SGLANG_K3_AGG_NUM_WARPS="${SGLANG_K3_AGG_NUM_WARPS:-8}"
# >>> Wave F adopted 2026-10-01
# Same session vs the closing landed baseline: decode TPOT 53.545 -> 51.185 ms (-4.4%),
# TTFT 5274.5 -> 5210.1 ms (-1.2%), mid TPOT 30.425 -> 28.675 ms (-5.8%); GSM8K 0.985, KL 0.142.
# Each line is a kill switch (set to 0 to revert that item). Patches: /opt/scripts/patches/.
export SGLANG_K3_MLA_FUSED_PREP="${SGLANG_K3_MLA_FUSED_PREP:-1}"
export SGLANG_K3_FRONT_EPILOGUE="${SGLANG_K3_FRONT_EPILOGUE:-1}"
export AITER_K3_FUSED_ROUTE_PREP="${AITER_K3_FUSED_ROUTE_PREP:-1}"
export SGLANG_K3_AITER_ATTN_RES="${SGLANG_K3_AITER_ATTN_RES:-1}"
# <<< Wave F adopted
# >>> Wave H adopted 2026-10-01
# #3 MoE output straight into the [latent | shared] buffer (no latent.copy_ per MoE layer).
# Same session, bracketed by landed baselines: decode TPOT -0.83%, mid TPOT -1.57%, TTFT -0.18%;
# GSM8K 0.985. Kill switch: set to 0. Patch: /opt/scripts/patches/moe_out_direct/.
export SGLANG_K3_MOE_OUT_DIRECT="${SGLANG_K3_MOE_OUT_DIRECT:-1}"
# <<< Wave H adopted
# >>> Wave I adopted 2026-10-02
# Token-parallel prefill for the replicated router + latent projections (>=1024 tokens, tokens % tp == 0):
# router/down on the 1/tp token slice + all-gather, reduce-scatter tail, up-proj on the slice, all-gather.
# Same session vs bracketing landed baselines: see prof/final/VERDICTS.md (Wave I). Kill switch: set to 0.
# Patch: /opt/scripts/patches/k3_tp_prefill_latent/.
export SGLANG_K3_TP_PREFILL_LATENT="${SGLANG_K3_TP_PREFILL_LATENT:-1}"
# <<< Wave I adopted
# >>> Wave M adopted 2026-10-02
# Prefill-only dynamic fp8 (per-token x per-channel, aiter gemm_a8w8_bpreshuffle) for the bf16-kept dense
# GEMMs at >= 1024 tokens: KDA wide in-proj, MoE shared gate_up + routed up slice (token-parallel branch),
# MLA output gate. Same session vs bracketing landed baselines: see prof/final/VERDICTS.md (Wave M).
# Patch: /opt/scripts/patches/k3_prefill_fp8/. Kill switch: set to empty.
export SGLANG_K3_PREFILL_FP8="${SGLANG_K3_PREFILL_FP8-kda,front,up,mla_gate}"
# <<< Wave M adopted
# >>> Wave M-decode adopted 2026-10-02
# Dynamic fp8 (per-token x per-channel, aiter gemm_a8w8_bpreshuffle) on the fused decode path: MoE merged
# front, routed up_proj, KDA wide in-proj ([f_a|b] tail stays bf16). fp8 copies built in post_load_weights.
# Same session vs bracketing landed baselines: see prof/final/VERDICTS.md (Wave M-decode). The kda site is
# the borderline one (GSM8K 0.98, 0.98, 0.985 on rerun): set to front,up to drop it, or empty to disable.
# Patch: /opt/scripts/patches/k3_decode_fp8/.
export SGLANG_K3_DECODE_FP8="${SGLANG_K3_DECODE_FP8-front,up,kda}"
# <<< Wave M-decode adopted
# >>> Wave N2 adopted 2026-10-02
# a16w4 MoE gemm2 LDS block sized max(A tile, epilogue accumulator) instead of their sum at BM >= 32
# (16 KB vs 20 KB, one more resident CTA per CU): 1.08x fused MoE @8192 tokens. Same session vs bracketing
# landed baselines: see prof/final/VERDICTS.md (Wave N2). Needs the patched gemm2.py (backup gemm2.py.pre_wave_n).
export A16WMIX_GEMM2_LDS_OVERLAY="${A16WMIX_GEMM2_LDS_OVERLAY:-1}"
# <<< Wave N2 adopted
# >>> Wave N1 adopted 2026-10-02
# Prefill stage-2 MoE intermediate quantized by k3_rowquant (16 rows per program, bit-identical to aiter's
# per-token kernel, 4.8x at 8192 tokens); decode-sized calls keep aiter's kernel. Same session vs
# bracketing landed baselines: see prof/final/VERDICTS.md (Wave N1). Patch /opt/scripts/patches/k3_s2_rowquant/.
export AITER_K3_S2_ROWQUANT="${AITER_K3_S2_ROWQUANT:-1}"
# <<< Wave N1 adopted
# >>> Wave L adopted 2026-10-03
# Prefill: o_proj reduce-scattered and the MLP-side attention-residual aggregation run on this rank's token
# rows (layers whose MoE takes the token-parallel branch). Same session vs bracketing landed baselines: see
# prof/final/VERDICTS.md (Wave L). Patch /opt/scripts/patches/k3_sp_prefill_agg2/ (revert it before Wave M / I).
export SGLANG_K3_SP_PREFILL_AGG2="${SGLANG_K3_SP_PREFILL_AGG2:-1}"
# <<< Wave L adopted
# >>> MLA a8w8 decode adopted 2026-10-05
# Decode MLA: fp8 q + aiter mla_a8w8_qh16_qseqlen1_gqaratio16_ps. Patch
# /opt/scripts/patches/k3_mla_decode_a8w8/. Revert the patch before reverting fused prep.
export SGLANG_K3_MLA_DECODE_A8W8="${SGLANG_K3_MLA_DECODE_A8W8:-1}"
# <<< MLA a8w8 decode adopted
# >>> MLA decode balanced metadata + PP recv-after-forward adopted 2026-10-08
# Patches /opt/scripts/patches/k3_mla_decode_balanced/ and k3_pp_recv_after_fwd/; evidence
# evo-kimi-k3-e2e/prof/decode_itl_probe/FINDINGS.md. Both are only read at server start.
export SGLANG_K3_MLA_DECODE_BALANCED="${SGLANG_K3_MLA_DECODE_BALANCED:-1}"
export SGLANG_K3_PP_RECV_AFTER_PREV_FWD="${SGLANG_K3_PP_RECV_AFTER_PREV_FWD:-2}"
# <<< MLA decode balanced metadata + PP recv-after-forward adopted
# >>> MLA prefill fp8 attention (fused fp8 emission) adopted 2026-10-12
# Patch /opt/scripts/patches/k3_mla_prefill_fp8attn/; evidence evo-kimi-k3-e2e/prof/prefill_fp8_sweep_20261012/.
export SGLANG_K3_MLA_PREFILL_FP8="${SGLANG_K3_MLA_PREFILL_FP8:-1}"
export SGLANG_K3_MLA_PREFILL_FP8_FUSED="${SGLANG_K3_MLA_PREFILL_FP8_FUSED:-1}"
# <<< MLA prefill fp8 attention adopted
