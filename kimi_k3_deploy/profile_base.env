# Sourced by k3_launch.sh for both profiles.
# D1 prefix attention, DCP8, HiCache 120 GB write-through, decode CUDA graphs up to bs 32.
CUDA_GRAPH_BACKEND_DECODE=full
CUDA_GRAPH_MAX_BS_DECODE=32
SGLANG_K3_PREFIX_LSE=1
SGLANG_K3_PREFIX_LSE_CHUNK=65536
EXTRA_ARGS="--disable-cuda-graph-padding --enable-metrics --enable-hierarchical-cache --hicache-size 120 --hicache-write-policy write_through --dcp-size 8"
